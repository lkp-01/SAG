# Intra host — sag-connector 使用 `env_file: ./.env.intra`（该文件不入库）。
# 在 REPO_ROOT 执行：
#   cp intra-host.env.example .env.intra
# 若 Edge IP 再变更，只改下面 SAG_TUNNEL_ENDPOINT 后重建 connector。
#
# 当前生产 Edge（与 edge-host.env.example 中 SAG_PUBLIC_HOST 一致）
SAG_TUNNEL_ENDPOINT=https://172.16.9.107:50051
# 多 Agent 时逐一填写真实实例地址，Connector 会分别建隧道；不要只填随机 LB 地址。
# SAG_TUNNEL_ENDPOINTS=https://172.16.9.107:50051,https://172.16.9.108:50051

# gRPC：SNI/校验名（与 Edge stealth 默认 server 证书一致）
SAG_GRPC_TLS_SERVER_NAME=localhost

# 显式使用仓库内 PEM（避免仅依赖编译期默认路径；与 stealth-agent 默认同源）
SAG_GRPC_TLS_CLIENT_CERT=/workspace/.secrets/tls/connector.crt
SAG_GRPC_TLS_CLIENT_KEY=/workspace/.secrets/tls/connector.key
SAG_GRPC_TLS_CA=/workspace/.secrets/tls/agent-ca.crt

# gRPC keepalive / 超时（与 Edge compose 默认一致；经 VPN/NAT 时做小步 A/B，一次只改一项）
SAG_GRPC_KEEPALIVE_MS=5000
SAG_GRPC_KEEPALIVE_TIMEOUT_MS=5000
SAG_GRPC_TCP_KEEPALIVE_MS=5000
SAG_CONNECTOR_STREAM_BUFFER=32768
# SAG_CONNECTOR_GRPC_CHANNEL_TIMEOUT_MS=120000

# 与控制面 bootstrap 的 demo 隧道路由一致：tunnel_routes.connector_endpoint 为
# `connector-local-001:stream`。二进制默认 SAG_CONNECTOR_ID 已是 connector-local-001；
# 若你曾设 SAG_CONNECTOR_ID=connector-intra-001，请删掉或改回，否则 agent 收不到匹配心跳 → N1「unhealthy」。
# SAG_APP_ID=app-001

# 若仍报 connector transport error，临时对照（勿长期关 mTLS）：
# SAG_GRPC_MTLS_ENABLED=false
