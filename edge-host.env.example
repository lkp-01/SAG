# Edge host env for docker-compose.edge.yml (+ docker-compose.release.edge.yml).
# Git tracks this file; secrets belong in a local-only `.env` (see below).
#
# On the Edge VM (after git pull):
#   cp edge-host.env.example .env
#   nano .env    # only if you rotate APISIX admin_key or move hosts
#
# New Edge VM (2026-05): 172.16.9.107 — Intra APISIX admin unchanged unless your infra moved.
# SAG_APISIX_ADMIN_API_KEY matches infra/apisix/config.yaml admin_key.key (verified on Intra).

# Browser / SSO / Fake 4A visible host (must be reachable from user laptops)
SAG_PUBLIC_HOST=172.16.9.107

# Intra: APISIX Admin API (control-plane reconciler). Change if Intra IP moved.
SAG_APISIX_ADMIN_BASE_URL=http://192.168.9.26:9180

# Same as infra/apisix/config.yaml deployment.admin.admin_key[].key (demo default).
SAG_APISIX_ADMIN_API_KEY=your-admin-key
SAG_CONFIG_SYNC_POLL_MS=500
SAG_CONFIG_SYNC_BATCH_SIZE=10
SAG_CONFIG_SYNC_OPERATION_TIMEOUT_MS=10000
SAG_CONFIG_SYNC_UNKNOWN_OUTCOME_ISOLATION_MS=60000
SAG_CONTROL_PLANE_HTTP_TIMEOUT_MS=8000
SAG_APISIX_RECONCILE_TIMEOUT_SEC=20
SAG_APISIX_RECONCILE_MAX_PAGES=20
SAG_APISIX_RECONCILE_MAX_ROUTES=10000
SAG_AGENT_APPLY_ACTIVE_WINDOW_SEC=300
SAG_AGENT_APPLY_RETENTION_SEC=604800
# Production default: do not overwrite unlabeled APISIX routes.
SAG_APISIX_ADOPT_LEGACY_ROUTES=false

# Admin Next.js: links embedded in UI (host publishes 3000/9091)
NEXT_PUBLIC_GRAFANA_URL=http://172.16.9.107:3000
NEXT_PUBLIC_PROMETHEUS_URL=http://172.16.9.107:9091

# --- Optional: tunnel B/C/D overrides (defaults now tuned in docker-compose.edge.yml) ---
SAG_AGENT_INSTANCE_ID=edge-agent-1
SAG_AGENT_MAX_ROUTE_SYNC_AGE_SEC=60
SAG_CONTROL_PLANE_SYNC_MAX_BODY_BYTES=4194304
SAG_CONTROL_PLANE_SYNC_MAX_ROUTES=10000
# Optional hscale overlay; must be unique within the same deployment.
SAG_AGENT_INSTANCE_ID_2=edge-agent-2
SAG_TUNNEL_HEALTHY_WINDOW_SEC=10
# Upgrade the Intra Connector first; then enable health-probe-v1 on this Agent.
SAG_CONNECTOR_PROBE_ENABLED=true
SAG_CONNECTOR_PROBE_INTERVAL_MS=2000
SAG_CONNECTOR_PROBE_TIMEOUT_MS=1500
SAG_CONNECTOR_PROBE_FRESHNESS_MS=6000
SAG_CONNECTOR_PROBE_STARTUP_GRACE_MS=5000
SAG_CONNECTOR_PROBE_FAILURE_THRESHOLD=3
SAG_AGENT_STREAM_SEND_TIMEOUT_MS=1000
# Production mTLS: copy externally issued files to the git-ignored .secrets/tls directory.
SAG_GRPC_TLS_CERT=/workspace/.secrets/tls/agent.crt
SAG_GRPC_TLS_KEY=/workspace/.secrets/tls/agent.key
SAG_GRPC_TLS_CLIENT_CA=/workspace/.secrets/tls/client-ca-bundle.crt
# Bridge is a separate mTLS client identity from Connector replicas.
SAG_GRPC_TLS_CLIENT_CERT=/workspace/.secrets/tls/bridge.crt
SAG_GRPC_TLS_CLIENT_KEY=/workspace/.secrets/tls/bridge.key
SAG_GRPC_TLS_CA=/workspace/.secrets/tls/agent-ca.crt
# Both Agent replicas present the same certificate identity in the hscale overlay.
SAG_GRPC_TLS_SERVER_NAME=stealth-tunnel-agent
SAG_REQUIRE_CONNECTOR_CERT_BINDING=true
# One entry per allowed replica certificate; repeated endpoint entries are supported.
SAG_CONNECTOR_CERT_BINDINGS=connector-local-001:stream=REPLACE_WITH_64_HEX_SHA256
# SAG_GRPC_KEEPALIVE_MS=5000
SAG_GRPC_KEEPALIVE_TIMEOUT_MS=5000
# SAG_GRPC_TCP_KEEPALIVE_MS=5000
# SAG_AGENT_STREAM_BUFFER=32768
# SAG_MAX_PENDING_WAITERS=16384
# SAG_BRIDGE_SOFT_INFLIGHT=24
# SAG_BRIDGE_MAX_TUNNEL_INFLIGHT=2048
# SAG_BRIDGE_WORKER_CONCURRENCY=64
# SAG_BRIDGE_QUEUE_MAX_LEN=20000
