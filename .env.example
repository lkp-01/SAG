# ========= Storage =========
SAG_STORAGE_BACKEND=sqlite
SAG_STORAGE_DB_PATH=./data/sag-storage/sag.db
# When SAG_STORAGE_BACKEND=postgres:
SAG_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
SAG_POSTGRES_DSN=postgres://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/sag
SAG_POSTGRES_POOL_MAX_SIZE=8
SAG_POSTGRES_POOL_ACQUIRE_TIMEOUT_MS=2000
SAG_POSTGRES_CONNECT_TIMEOUT_MS=5000
SAG_POSTGRES_QUERY_TIMEOUT_MS=5000
# Set to the total count of PostgreSQL-using process replicas in this release.
SAG_POSTGRES_REPLICA_BUDGET=6
SAG_POSTGRES_RESERVED_CONNECTIONS=10
SAG_POSTGRES_MAX_CONNECTIONS=100

# ========= Bounded audit pipeline (per process) =========
SAG_AUDIT_QUEUE_CAPACITY=4096
SAG_AUDIT_BATCH_SIZE=100
SAG_AUDIT_FLUSH_INTERVAL_MS=250
SAG_AUDIT_DRAIN_TIMEOUT_MS=5000

# ========= Redis =========
SAG_REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
SAG_SESSION_REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_PASSWORD@redis:6379/0
SAG_POLICY_CACHE_REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_PASSWORD@redis:6379/0
SAG_BRIDGE_REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_PASSWORD@redis:6379/2
# Production: use rediss:// for a managed HA primary, or set all Sentinel fields below.
# For Sentinel, SAG_BRIDGE_REDIS_URL supplies master TLS/auth/db parameters; its host is replaced by discovery.
SAG_BRIDGE_REDIS_SENTINELS=
SAG_BRIDGE_REDIS_SENTINEL_SERVICE=
SAG_BRIDGE_REDIS_CONNECT_TIMEOUT_MS=2000
SAG_BRIDGE_REDIS_COMMAND_TIMEOUT_MS=5000
SAG_BRIDGE_REDIS_RECONNECT_RETRIES=6
SAG_BRIDGE_REDIS_RECONNECT_BASE_MS=100
SAG_BRIDGE_REDIS_RECONNECT_MAX_MS=2000
SAG_BRIDGE_READ_ONLY_SYNC_FALLBACK_ON_QUEUE_ERROR=false

# ========= APISIX =========
SAG_APISIX_BASE_URL=http://127.0.0.1:9080
SAG_APISIX_ADMIN_BASE_URL=http://127.0.0.1:9180
SAG_APISIX_ADMIN_API_KEY=REPLACE_WITH_RANDOM_APISIX_ADMIN_KEY
SAG_CONFIG_SYNC_POLL_MS=500
SAG_CONFIG_SYNC_BATCH_SIZE=10
SAG_CONFIG_SYNC_OPERATION_TIMEOUT_MS=10000
SAG_CONFIG_SYNC_UNKNOWN_OUTCOME_ISOLATION_MS=60000
SAG_CONTROL_PLANE_HTTP_TIMEOUT_MS=8000
SAG_APISIX_RECONCILE_TIMEOUT_SEC=20
SAG_APISIX_RECONCILE_MAX_PAGES=20
SAG_APISIX_RECONCILE_MAX_ROUTES=10000
SAG_AGENT_APPLY_ACTIVE_WINDOW_SEC=300
SAG_AGENT_APPLY_RETENTION_SEC=604800
# Local one-time migration only; set false after verified legacy routes gain SAG ownership labels.
SAG_APISIX_ADOPT_LEGACY_ROUTES=true

# ========= Auth =========
SAG_JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
SAG_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
SAG_PUBLIC_READONLY_TOKEN=REPLACE_WITH_RANDOM_READONLY_TOKEN
SAG_AGENT_SYNC_TOKEN=REPLACE_WITH_RANDOM_AGENT_SYNC_TOKEN
SAG_POLICY_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_POLICY_INTERNAL_TOKEN
SAG_FOURA_CLIENT_SECRET=REPLACE_WITH_4A_CLIENT_SECRET
SAG_GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_GRAFANA_PASSWORD
SAG_BOOTSTRAP_DEMO_TUNNEL_ROUTE=true
SAG_FOURA_DEFAULT_ROLES=user

# ========= Tunnel =========
SAG_AGENT_INSTANCE_ID=local-agent-1
SAG_AGENT_MAX_ROUTE_SYNC_AGE_SEC=60
SAG_TUNNEL_ENDPOINT=https://127.0.0.1:50051
# Multi-Agent mode: list every concrete Agent address; do not use one random LB address.
# SAG_TUNNEL_ENDPOINTS=https://agent-1:50051,https://agent-2:50051
SAG_CONNECTOR_ID=connector-local-001
SAG_CONNECTOR_HEARTBEAT_INTERVAL_MS=2000
SAG_TUNNEL_HEALTHY_WINDOW_SEC=10
# Enable only after every Connector has been upgraded to advertise health-probe-v1.
SAG_CONNECTOR_PROBE_ENABLED=true
SAG_CONNECTOR_PROBE_INTERVAL_MS=2000
SAG_CONNECTOR_PROBE_TIMEOUT_MS=1500
SAG_CONNECTOR_PROBE_FRESHNESS_MS=6000
SAG_CONNECTOR_PROBE_STARTUP_GRACE_MS=5000
SAG_CONNECTOR_PROBE_FAILURE_THRESHOLD=3
SAG_AGENT_STREAM_SEND_TIMEOUT_MS=1000
SAG_CONNECTOR_OUTBOUND_SEND_TIMEOUT_MS=2000
SAG_GRPC_KEEPALIVE_MS=5000
SAG_GRPC_KEEPALIVE_TIMEOUT_MS=5000
# Local development fixture only. Release Compose rejects missing external TLS
# paths; never use these repository fixtures in production.
SAG_GRPC_TLS_CERT=./infra/tls/server-default.crt
SAG_GRPC_TLS_KEY=./infra/tls/server-default.key
SAG_GRPC_TLS_CLIENT_CA=./infra/tls/ca.crt
SAG_GRPC_TLS_CLIENT_CERT=./infra/tls/client.crt
SAG_GRPC_TLS_CLIENT_KEY=./infra/tls/client.key
SAG_GRPC_TLS_CA=./infra/tls/ca.crt
SAG_REQUIRE_CONNECTOR_CERT_BINDING=true
SAG_CONNECTOR_CERT_BINDINGS=connector-local-001:stream=76594a109bcb0b7042f3b4d8ea9e3d538ee34cbdf20514f7fcbc499c7a99f013
# Per-process bounded memory inputs. Compose maps service-specific budgets to
# the binary-level SAG_MEMORY_BUDGET_BYTES variable.
SAG_BRIDGE_MEMORY_BUDGET_BYTES=536870912
SAG_BRIDGE_SOFT_INFLIGHT=24
SAG_BRIDGE_HARD_INFLIGHT=128
SAG_BRIDGE_MAX_TUNNEL_INFLIGHT=128
SAG_BRIDGE_WORKER_CONCURRENCY=16
SAG_BRIDGE_MAX_BODY_BYTES=1048576
SAG_BRIDGE_MAX_RESPONSE_BODY_BYTES=1048576
SAG_AGENT_MEMORY_BUDGET_BYTES=805306368
SAG_MAX_PENDING_WAITERS=128
SAG_AGENT_STREAM_BUFFER=128
SAG_AGENT_MAX_REQUEST_BODY_BYTES=1048576
SAG_AGENT_MAX_RESPONSE_BODY_BYTES=1048576
SAG_CONNECTOR_MEMORY_BUDGET_BYTES=1610612736
SAG_CONNECTOR_MAX_INFLIGHT=256
SAG_CONNECTOR_ACCEPT_QUEUE=256
SAG_CONNECTOR_STREAM_BUFFER=128
SAG_CONNECTOR_MAX_REQUEST_BODY_BYTES=1048576
SAG_CONNECTOR_MAX_RESPONSE_BODY_BYTES=1048576
# Public Edge is not part of docker-compose.edge.yml; set these in its process environment.
PUBLIC_EDGE_MAX_INFLIGHT=32
PUBLIC_EDGE_MAX_REQUEST_BODY_BYTES=1048576
PUBLIC_EDGE_MAX_RESPONSE_BODY_BYTES=4194304
PUBLIC_EDGE_CONNECT_TIMEOUT_MS=3000
PUBLIC_EDGE_FIRST_BYTE_TIMEOUT_MS=10000
PUBLIC_EDGE_TOTAL_TIMEOUT_MS=60000
PUBLIC_EDGE_UPSTREAM_TLS_INSECURE=false
# sag-connector timeouts
# SAG_CONNECTOR_HTTP_TIMEOUT_MS=55000
# SAG_CONNECTOR_GRPC_CHANNEL_TIMEOUT_MS=120000
# Persistent replay ledger retention for mutating requests (Agent-owned storage).
# SAG_IDEMPOTENCY_TTL_SEC=86400
# k6 load script (run-load-dataplane.ps1 -PollDataplane202); optional:
# SAG_DP_POLL_202=1
# SAG_DP_POLL_MAX_MS=120000
# SAG_DP_POLL_INTERVAL_MS=100
SAG_APP_ID=app-001
SAG_EXTERNAL_HOST=app.internal.com
SAG_CONTROL_PLANE_SYNC_ENDPOINT=http://127.0.0.1:8090/api/v1/agent/routes
SAG_CONTROL_PLANE_SYNC_NO_LOCALHOST_FALLBACK=false
SAG_CONTROL_PLANE_SYNC_MAX_BODY_BYTES=4194304
SAG_CONTROL_PLANE_SYNC_MAX_ROUTES=10000

# ========= Service Ports =========
SAG_HTTP_LISTEN_ADDR=0.0.0.0:9000
SAG_STEALTH_LISTEN_ADDR=0.0.0.0:50051
