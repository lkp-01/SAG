# Edge 28 logical CPUs (0-27) — lxz-Super-Server / 172.16.9.107
# Use with hscale: edge.perf.yml + hscale-edge.yml + hscale-edge.perf.yml

SAG_EDGE_CPUSET_POSTGRES=0
SAG_EDGE_CPUSET_REDIS=0
SAG_EDGE_CPUSET_CONTROL=1
SAG_EDGE_CPUSET_AUTH=2
SAG_EDGE_CPUSET_AUTH_2=3
SAG_EDGE_CPUSET_AUTH_LB=26
# Avoid CPU 3 overlap with sag-auth-2 (SAG_EDGE_CPUSET_AUTH_2=3).
SAG_EDGE_CPUSET_POLICY=4-7
SAG_EDGE_CPUSET_STEALTH=7-11
SAG_EDGE_CPUSET_BRIDGE=12-14
SAG_EDGE_CPUSET_BRIDGE_2=15-17
SAG_EDGE_CPUSET_ZENTINEL_HSCALE=18-25
SAG_EDGE_CPUSET_FRONTEND=0
SAG_EDGE_CPUSET_SSO=0
SAG_EDGE_CPUSET_OBS=0

# 26-27 未绑定，留给宿主机 / 突发；若要占用可并入 ZENTINEL 或 STEALTH
# Per-bridge gRPC channel pool (master plan §1.3)
SAG_BRIDGE_GRPC_CHANNEL_POOL_SIZE=4
