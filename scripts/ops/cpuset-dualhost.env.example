# Dual-host CPU affinity (cpuset) — copy to cpuset-dualhost.env and edit for your host core count.
# Ready-made profiles: cpuset-edge-28.env (28c Edge) + cpuset-intra-8.env (8c Intra).
# Legacy: cpuset-edge-14.env (14c).
# Apply on Edge (lxz-Super-Server) and Intra (Gzh) separately.
#
# Check cores: nproc
# Verify after up: docker inspect <container> --format '{{.HostConfig.CpusetCpus}}'
#
# --- What is actually "horizontally scaled" in SAG ---
# • Business apps (app-dev, app-ci, …): control-plane routes + APISIX vars — NOT extra containers per app.
# • Infra scale (compose): primarily http-tunnel-bridge (×N or bridge-2 via hscale); optionally auth/policy/admin.
# • Do NOT compose-scale: stealth-tunnel-agent, sag-connector (same ID), postgres, redis.
#
# --- Edge (172.16.9.107) — single bridge (default prod) ---
SAG_EDGE_CPUSET_POSTGRES=0
SAG_EDGE_CPUSET_REDIS=0
SAG_EDGE_CPUSET_CONTROL=1
SAG_EDGE_CPUSET_AUTH=1
SAG_EDGE_CPUSET_POLICY=2-3
SAG_EDGE_CPUSET_STEALTH=4
SAG_EDGE_CPUSET_BRIDGE=5
SAG_EDGE_CPUSET_ZENTINEL=6-7
SAG_EDGE_CPUSET_FRONTEND=0
SAG_EDGE_CPUSET_SSO=0
SAG_EDGE_CPUSET_OBS=0
#
# --- Edge — hscale (second bridge); use docker-compose.hscale-edge.yml + hscale-edge.perf.yml ---
# Avoid overlap: bridge-2 on 6, zentinel on 7 only (override edge.perf zentinel via hscale-edge.perf.yml).
# SAG_EDGE_CPUSET_BRIDGE_2=6
# SAG_EDGE_CPUSET_ZENTINEL_HSCALE=7
#
# Warning: `docker compose up --scale http-tunnel-bridge=2` gives BOTH replicas the SAME cpuset (bridge=5).
# Prefer hscale (bridge + bridge-2) for disjoint CPU pinning per bridge process.
#
# --- Intra (192.168.9.26) ---
SAG_INTRA_CPUSET_ETCD=0
SAG_INTRA_CPUSET_APISIX=1-2
SAG_INTRA_CPUSET_MOCK=1
SAG_INTRA_CPUSET_CONNECTOR=3
SAG_INTRA_CPUSET_DEMO=0
SAG_INTRA_CPUSET_OBS=0
