# Full-chain performance target contract. Copy to perf-target.env; never commit secrets.
# Run only from an independent Linux host/VM with CPU <=85% and network <=80%.
SAG_PERF_ENVIRONMENT=candidate-edge-intra
SAG_EDGE_HOST=192.0.2.10
DATAPLANE_URL=https://gateway.example.test/dev/
AUTH_BASE_URL=https://auth.example.test
POLICY_BASE_URL=https://policy.example.test
CONTROL_BASE_URL=https://control.example.test
SAG_APP_ID=app-001

# Supply via a secret manager on the load generator, not in this file.
# SAG_AUTH_USERNAME=
# SAG_AUTH_PASSWORD=

# Immutable provenance/evidence captured for the exact test window.
SAG_IMAGE_DIGESTS_JSON=/secure/perf/image-digests.json
SAG_RESOURCE_EVIDENCE_JSON=/secure/perf/resource-watermarks.json
SAG_DEPENDENCY_EVIDENCE_JSON=/secure/perf/dependency-evidence.json

# Gate defaults. Start low, raise each tier by only 20-25% until the first
# repeatable saturation point. Do not copy historical routed values.
SAG_GATE_STEADY_MINUTES=10
SAG_AUDIT_SAMPLE_EVERY_N=100
SAG_AUDIT_LAG_TIMEOUT_MS=5000
SAG_EXPECT_DATAPLANE_STATUS=200

# Task 9 bounded defaults are the starting point, not a target to inflate.
SAG_BRIDGE_HARD_INFLIGHT=128
SAG_BRIDGE_SOFT_INFLIGHT=24
SAG_BRIDGE_QUEUE_WORKERS=16
SAG_AGENT_MAX_PENDING=128
SAG_CONNECTOR_MAX_INFLIGHT=256
SAG_CONNECTOR_ACCEPT_QUEUE=256

# Example after the environment, immutable images, routes, Auth/Policy policy,
# audit storage, Redis and APISIX evidence collectors are ready:
# scripts/ops/run-production-gate.sh full_chain 100 3 120
# Increase the next candidate to 120-125 only after the entire gate passes.
