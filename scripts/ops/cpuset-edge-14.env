# Edge 14 logical CPUs (0-13) — 小规格备用；生产 Edge 为 28 核请用 cpuset-edge-28.env
# lxz-Super-Server / 172.16.9.107
# Use with: docker-compose.edge.perf.yml + docker-compose.hscale-edge.perf.yml + hscale-edge.yml

SAG_EDGE_CPUSET_POSTGRES=0
SAG_EDGE_CPUSET_REDIS=0
SAG_EDGE_CPUSET_CONTROL=1
SAG_EDGE_CPUSET_AUTH=1
SAG_EDGE_CPUSET_POLICY=2-3
SAG_EDGE_CPUSET_STEALTH=4-5
SAG_EDGE_CPUSET_BRIDGE=6-7
SAG_EDGE_CPUSET_BRIDGE_2=8-9
SAG_EDGE_CPUSET_ZENTINEL_HSCALE=10-13
SAG_EDGE_CPUSET_FRONTEND=0
SAG_EDGE_CPUSET_SSO=0
SAG_EDGE_CPUSET_OBS=0

# hscale: per-bridge gRPC channel pool (master plan §1.3 / bridge-grpc-channel-pool)
SAG_BRIDGE_GRPC_CHANNEL_POOL_SIZE=2
