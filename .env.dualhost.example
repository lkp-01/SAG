# Two-host (edge/intra) deployment over VPN + internal DNS.
# Fill these with your VPN-reachable hostnames/IPs.
#
# Naming convention (recommended):
# - Edge host provides: zentinel ingress, bridge, stealth-tunnel-agent, control-plane-admin, auth, policy, frontends
# - Intra host provides: connector, apisix (+etcd), workloads
#
# DNS requirement:
# - Your internal DNS should resolve the business hosts (e.g. dev.internal.com) to the Edge host ingress IP.

# ========= Edge host addresses (VPN/DNS) =========
SAG_EDGE_ADMIN_BASE=http://192.168.8.87:8090
SAG_EDGE_AUTH_BASE=http://192.168.8.87:8080
SAG_EDGE_POLICY_BASE=http://192.168.8.87:8081
SAG_EDGE_ZENTINEL_BASE=https://192.168.8.87:10080
SAG_EDGE_TUNNEL_GRPC=https://192.168.8.87:50051

# ========= Intra host addresses (VPN/DNS) =========
SAG_INTRA_APISIX_DATA=http://192.168.9.26:9080
SAG_INTRA_APISIX_ADMIN=http://192.168.9.26:9180

# ========= Connector (runs on intra host; copy into `.env.intra` — not the same file as Edge `.env`) =========
SAG_TUNNEL_ENDPOINT=${SAG_EDGE_TUNNEL_GRPC}
SAG_GRPC_TLS_SERVER_NAME=localhost
# Must match control-plane bootstrap demo tunnel row (connector_endpoint = {id}:stream).
SAG_CONNECTOR_ID=connector-local-001
SAG_APP_ID=app-001
SAG_EXTERNAL_HOST=app.internal.com
SAG_APISIX_BASE_URL=http://apisix:9080
SAG_CONNECTOR_HEARTBEAT_INTERVAL_MS=2000
SAG_CONNECTOR_RECONNECT_ENABLED=true
SAG_CONNECTOR_OUTBOUND_SEND_TIMEOUT_MS=2000
SAG_GRPC_KEEPALIVE_MS=10000
SAG_GRPC_KEEPALIVE_TIMEOUT_MS=5000
SAG_GRPC_TCP_KEEPALIVE_MS=10000

# ========= Bridge + Agent (runs on edge host) =========
SAG_AGENT_INSTANCE_ID=edge-agent-1
SAG_AGENT_MAX_ROUTE_SYNC_AGE_SEC=60
# Optional hscale overlay; must differ from SAG_AGENT_INSTANCE_ID.
SAG_AGENT_INSTANCE_ID_2=edge-agent-2
SAG_CONTROL_PLANE_SYNC_ENDPOINT=http://control-plane-admin:8090/api/v1/agent/routes
SAG_CONTROL_PLANE_SYNC_NO_LOCALHOST_FALLBACK=true
SAG_CONTROL_PLANE_SYNC_MAX_BODY_BYTES=4194304
SAG_CONTROL_PLANE_SYNC_MAX_ROUTES=10000
SAG_POLICY_EVALUATE_ENDPOINT=http://sag-policy:8081/api/v1/policy/evaluate
SAG_APISIX_ADMIN_BASE_URL=${SAG_INTRA_APISIX_ADMIN}
SAG_APISIX_ADMIN_API_KEY=REPLACE_WITH_RANDOM_APISIX_ADMIN_KEY
SAG_CONFIG_SYNC_POLL_MS=500
SAG_CONFIG_SYNC_BATCH_SIZE=10
SAG_CONFIG_SYNC_OPERATION_TIMEOUT_MS=10000
SAG_CONFIG_SYNC_UNKNOWN_OUTCOME_ISOLATION_MS=60000
SAG_CONTROL_PLANE_HTTP_TIMEOUT_MS=8000
SAG_APISIX_RECONCILE_TIMEOUT_SEC=20
SAG_APISIX_RECONCILE_MAX_PAGES=20
SAG_APISIX_RECONCILE_MAX_ROUTES=10000
SAG_AGENT_APPLY_ACTIVE_WINDOW_SEC=300
SAG_AGENT_APPLY_RETENTION_SEC=604800
# Production default: do not overwrite unlabeled APISIX routes.
SAG_APISIX_ADOPT_LEGACY_ROUTES=false
SAG_APISIX_RECONCILE_ENABLED=true
SAG_APISIX_RECONCILE_INTERVAL_SEC=30
SAG_BRIDGE_FORWARD_TIMEOUT_MS=60000
SAG_TUNNEL_HEALTHY_WINDOW_SEC=10
# Upgrade the Intra Connector first; then enable health-probe-v1 on the Edge Agent.
SAG_CONNECTOR_PROBE_ENABLED=true
SAG_CONNECTOR_PROBE_INTERVAL_MS=2000
SAG_CONNECTOR_PROBE_TIMEOUT_MS=1500
SAG_CONNECTOR_PROBE_FRESHNESS_MS=6000
SAG_CONNECTOR_PROBE_STARTUP_GRACE_MS=5000
SAG_CONNECTOR_PROBE_FAILURE_THRESHOLD=3
SAG_AGENT_STREAM_SEND_TIMEOUT_MS=1000
# Edge Agent mTLS files must be local-only files, not infra/tls test fixtures.
SAG_GRPC_TLS_CERT=/workspace/.secrets/tls/agent.crt
SAG_GRPC_TLS_KEY=/workspace/.secrets/tls/agent.key
SAG_GRPC_TLS_CLIENT_CA=/workspace/.secrets/tls/client-ca-bundle.crt
SAG_GRPC_TLS_CLIENT_CERT=/workspace/.secrets/tls/bridge.crt
SAG_GRPC_TLS_CLIENT_KEY=/workspace/.secrets/tls/bridge.key
SAG_GRPC_TLS_CA=/workspace/.secrets/tls/agent-ca.crt
SAG_REQUIRE_CONNECTOR_CERT_BINDING=true
# Replace with: openssl x509 -in connector.crt -outform DER | openssl dgst -sha256
SAG_CONNECTOR_CERT_BINDINGS=connector-local-001:stream=REPLACE_WITH_64_HEX_SHA256

# ========= Storage (edge host `.env` only) =========
SAG_STORAGE_BACKEND=postgres
SAG_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
SAG_POSTGRES_DSN=postgres://postgres:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/sag
SAG_POSTGRES_POOL_MAX_SIZE=8
SAG_POSTGRES_POOL_ACQUIRE_TIMEOUT_MS=2000
SAG_POSTGRES_CONNECT_TIMEOUT_MS=5000
SAG_POSTGRES_QUERY_TIMEOUT_MS=5000
# Count every PostgreSQL-using Edge process replica, not only one service type.
SAG_POSTGRES_REPLICA_BUDGET=6
SAG_POSTGRES_RESERVED_CONNECTIONS=10
SAG_POSTGRES_MAX_CONNECTIONS=100
SAG_AUDIT_QUEUE_CAPACITY=4096
SAG_AUDIT_BATCH_SIZE=100
SAG_AUDIT_FLUSH_INTERVAL_MS=250
SAG_AUDIT_DRAIN_TIMEOUT_MS=5000
SAG_JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
SAG_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
SAG_PUBLIC_READONLY_TOKEN=REPLACE_WITH_RANDOM_READONLY_TOKEN
SAG_AGENT_SYNC_TOKEN=REPLACE_WITH_RANDOM_AGENT_SYNC_TOKEN
SAG_POLICY_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_POLICY_INTERNAL_TOKEN
SAG_FOURA_CLIENT_SECRET=REPLACE_WITH_4A_CLIENT_SECRET
SAG_GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_GRAFANA_PASSWORD

# ========= Redis (edge host) =========
SAG_REDIS_PASSWORD=REPLACE_WITH_RANDOM_REDIS_PASSWORD
SAG_SESSION_REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_PASSWORD@redis:6379/0
SAG_POLICY_CACHE_REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_PASSWORD@redis:6379/0
SAG_BRIDGE_REDIS_URL=redis://:REPLACE_WITH_URL_ENCODED_PASSWORD@redis:6379/2
# Production: use rediss:// managed HA, or configure both Sentinel variables.
SAG_BRIDGE_REDIS_SENTINELS=
SAG_BRIDGE_REDIS_SENTINEL_SERVICE=
SAG_BRIDGE_REDIS_CONNECT_TIMEOUT_MS=2000
SAG_BRIDGE_REDIS_COMMAND_TIMEOUT_MS=5000
SAG_BRIDGE_REDIS_RECONNECT_RETRIES=6
SAG_BRIDGE_REDIS_RECONNECT_BASE_MS=100
SAG_BRIDGE_REDIS_RECONNECT_MAX_MS=2000
SAG_BRIDGE_READ_ONLY_SYNC_FALLBACK_ON_QUEUE_ERROR=false

# ========= Frontends (edge host; browser-visible URLs) =========
VITE_CONTROL_PROXY_TARGET=http://control-plane-admin:8090
VITE_AUTH_PROXY_TARGET=http://sag-auth:8080
VITE_POLICY_PROXY_TARGET=http://sag-policy:8081
VITE_BRIDGE_PROXY_TARGET=http://http-tunnel-bridge:9000
VITE_ZENTINEL_PROXY_TARGET=https://zentinel:10080
VITE_ADMIN_PLANE_URL=http://edge.sag.intra:5173
VITE_DEMO_SITES_BASE=http://edge.sag.intra:28080
